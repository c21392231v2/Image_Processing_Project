{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Count separated LEGO",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/object_counter_prototype.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": ["multiple_lego_pieces.png"]
        },
        {
            "name": "Count three red bricks",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/object_counter_prototype.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "3_red_lego_pieces.png",
                "--foreground", "red",
                "--method", "watershed",
                "--seed-fraction", "0.70"
            ]
        },
        {
            "name": "Count two red bricks",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/object_counter_prototype.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "2_red_lego_pieces.png",
                "--foreground", "red",
                "--method", "watershed",
                "--seed-fraction", "0.75"
            ]
        },
        {
            "name": "Count LEGO from image path",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/object_counter_prototype.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": ["${input:legoImagePath}", "--foreground", "auto"]
        }
    ],
    "inputs": [
        {
            "id": "legoImagePath",
            "type": "promptString",
            "description": "Enter the image path relative to the project folder, or paste its full path"
        }
    ]
}